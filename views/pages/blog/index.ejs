<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head') %>
<body>
  <%- include('../../partials/header') %>

  <main style="padding: 60px 0;">
    <div class="container">
      <div class="text-center mb-4">
        <h1 style="font-size: 3rem; color: var(--accent-cyan); margin-bottom: 20px;">The Hub Blog</h1>
        <p class="text-muted">Stay up to date with the latest threats, trends, and tutorials.</p>
      </div>

      <div style="background-color: var(--bg-card); padding: 20px; border-radius: 8px; margin-bottom: 40px; display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between; align-items: center;">
        <form action="/blog" method="GET" style="display: flex; gap: 10px; flex: 1; max-width: 400px;">
          <input type="text" name="search" class="form-control" placeholder="Search articles..." value="<%= search || '' %>">
          <button type="submit" class="btn btn-primary">Search</button>
        </form>
        
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/blog" class="btn btn-outline <%= !category ? 'active' : '' %>" style="padding: 5px 15px;">All</a>
          <a href="/blog?category=Malware" class="btn btn-outline <%= category === 'Malware' ? 'active' : '' %>" style="padding: 5px 15px;">Malware</a>
          <a href="/blog?category=Phishing" class="btn btn-outline <%= category === 'Phishing' ? 'active' : '' %>" style="padding: 5px 15px;">Phishing</a>
          <a href="/blog?category=Privacy" class="btn btn-outline <%= category === 'Privacy' ? 'active' : '' %>" style="padding: 5px 15px;">Privacy</a>
          <a href="/blog?category=Careers" class="btn btn-outline <%= category === 'Careers' ? 'active' : '' %>" style="padding: 5px 15px;">Careers</a>
        </div>
      </div>

      <div class="grid-3">
        <% if (posts && posts.length > 0) { %>
          <% posts.forEach(post => { %>
            <div class="card">
              <img src="<%= post.image_url || 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=600&q=80' %>" alt="<%= post.title %>" class="blog-card-img">
              <div class="blog-meta">
                <span style="color: var(--accent-cyan);"><%= post.category %></span>
                <span><%= new Date(post.created_at).toLocaleDateString() %></span>
              </div>
              <h3 class="blog-title"><a href="/blog/<%= post.slug %>" style="color: var(--text-main);"><%= post.title %></a></h3>
              <p class="text-muted" style="margin-bottom: 15px; font-size: 0.95rem;"><%= post.excerpt %></p>
              <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 15px; margin-top: auto;">
                <span style="font-size: 0.85rem; color: var(--text-muted);">By <%= post.author_name %></span>
                <a href="/blog/<%= post.slug %>" style="color: var(--accent-green); font-size: 0.9rem;">Read →</a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px;">
            <h3 style="color: var(--text-muted);">No posts found matching your criteria.</h3>
            <a href="/blog" class="btn btn-primary mt-4">View All Posts</a>
          </div>
        <% } %>
      </div>
      
      <!-- Pagination Placeholder -->
      <div class="text-center mt-4">
        <button class="btn btn-outline" disabled>Previous</button>
        <button class="btn btn-outline" style="margin-left: 10px;" disabled>Next</button>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
