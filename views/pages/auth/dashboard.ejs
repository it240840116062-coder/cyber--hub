<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head') %>
<body>
  <%- include('../../partials/header') %>

  <main style="padding: 60px 0;">
    <div class="container">
      <div class="card mb-4" style="border-left: 4px solid var(--accent-green);">
        <h2>Welcome back, <%= user.username %>!</h2>
        <p class="text-muted mt-2">Role: <%= user.role %></p>
      </div>

      <div class="grid-2">
        <div class="card">
          <h3 class="mb-4">Profile Information</h3>
          <p class="mb-2"><strong>Email:</strong> <%= user.email %></p>
          <p class="text-muted" style="font-size: 0.9rem;">To change your email or password, please contact an administrator.</p>
          <button class="btn btn-outline mt-4" onclick="showToast('Profile editing is disabled in demo mode.')">Edit Profile</button>
        </div>

        <% if (user.role === 'admin') { %>
          <div class="card">
            <h3 class="mb-4" style="color: var(--accent-cyan);">Author Dashboard</h3>
            <p class="text-muted mb-4">You have author privileges. You can create, edit, and delete blog posts.</p>
            <a href="/blog/create" class="btn btn-primary mb-4">Create New Post</a>
            
            <h4>Your Posts</h4>
            <% if (myPosts && myPosts.length > 0) { %>
              <ul style="list-style: none; margin-top: 10px;">
                <% myPosts.forEach(post => { %>
                  <li style="padding: 10px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                    <a href="/blog/<%= post.slug %>" style="color: var(--text-main);"><%= post.title %></a>
                    <div>
                      <a href="/blog/edit/<%= post.id %>" class="btn btn-outline" style="padding: 5px 10px; font-size: 0.8rem;">Edit</a>
                      <form action="/blog/delete/<%= post.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this post?');">
                        <button type="submit" class="btn btn-danger" style="padding: 5px 10px; font-size: 0.8rem;">Delete</button>
                      </form>
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <p class="text-muted mt-2">You haven't written any posts yet.</p>
            <% } %>
          </div>
        <% } else { %>
          <div class="card">
            <h3 class="mb-4">Saved Articles</h3>
            <p class="text-muted">You have no saved articles. Browse the <a href="/blog">Blog</a> to find something interesting!</p>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
