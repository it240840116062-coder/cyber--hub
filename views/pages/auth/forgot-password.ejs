<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head') %>
<body>
  <%- include('../../partials/header') %>

  <main style="display: flex; justify-content: center; align-items: center; padding: 60px 20px;">
    <div class="card" style="width: 100%; max-width: 450px;">
      <h2 class="text-center mb-4" style="color: var(--accent-cyan);">Forgot Password</h2>
      <p class="text-center text-muted mb-4">Enter your email address and we'll send you a link to reset your password.</p>
      
      <form id="forgot-form">
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" name="email" class="form-control" required>
        </div>
        
        <div id="msg-box" class="text-center mb-2" style="display: none; padding: 10px; border-radius: 4px;"></div>
        
        <button type="submit" class="btn btn-primary" style="width: 100%;">Send Reset Link</button>
      </form>
      
      <p class="text-center mt-4 text-muted"><a href="/auth/login">Back to Login</a></p>
    </div>
  </main>

  <%- include('../../partials/footer') %>

  <script>
    const form = document.getElementById('forgot-form');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.email.value;
      const msgBox = document.getElementById('msg-box');
      
      msgBox.style.display = 'none';
      
      try {
        const res = await fetch('/auth/forgot-password', {
          method: 'POST',
          body: JSON.stringify({ email }),
          headers: {'Content-Type': 'application/json'}
        });
        const data = await res.json();
        
        msgBox.textContent = data.message;
        msgBox.style.display = 'block';
        msgBox.style.backgroundColor = 'rgba(0, 255, 102, 0.1)';
        msgBox.style.color = 'var(--accent-green)';
        msgBox.style.border = '1px solid var(--accent-green)';
        
        form.reset();
      } catch (err) {
        msgBox.textContent = 'An error occurred. Please try again.';
        msgBox.style.display = 'block';
        msgBox.style.backgroundColor = 'rgba(239, 68, 68, 0.1)';
        msgBox.style.color = 'var(--danger)';
        msgBox.style.border = '1px solid var(--danger)';
      }
    });
  </script>
</body>
</html>
