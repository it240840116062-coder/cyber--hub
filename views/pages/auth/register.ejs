<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head') %>
<body>
  <%- include('../../partials/header') %>

  <main style="display: flex; justify-content: center; align-items: center; padding: 60px 20px;">
    <div class="card" style="width: 100%; max-width: 500px;">
      <h2 class="text-center mb-4" style="color: var(--accent-green);">Create an Account</h2>
      
      <form id="register-form">
        <div class="form-group">
          <label>Full Name</label>
          <input type="text" name="fullName" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Username</label>
          <input type="text" name="username" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" id="reg-pwd" class="form-control" required>
          <div class="progress-bar-container" style="height: 4px; margin-top: 5px;">
            <div class="progress-bar" id="reg-meter" style="width: 0%; background-color: var(--danger);"></div>
          </div>
          <small class="text-muted">Must be 8+ chars, with uppercase, number & special char.</small>
        </div>
        <div class="form-group">
          <label>Confirm Password</label>
          <input type="password" name="confirmPassword" class="form-control" required>
        </div>
        
        <label style="display: flex; align-items: start; gap: 10px; font-weight: normal; font-size: 0.9rem; margin-bottom: 20px;">
          <input type="checkbox" required style="margin-top: 4px;"> 
          <span class="text-muted">I agree to the Terms of Service and Privacy Policy. I understand this platform is for educational purposes only.</span>
        </label>
        
        <div id="error-msg" class="text-center mb-2" style="color: var(--danger); display: none;"></div>
        
        <button type="submit" class="btn btn-primary" style="width: 100%;">Register</button>
      </form>
      
      <p class="text-center mt-4 text-muted">Already have an account? <a href="/auth/login">Login here</a></p>
    </div>
  </main>

  <%- include('../../partials/footer') %>

  <script>
    const pwdInput = document.getElementById('reg-pwd');
    const pwdMeter = document.getElementById('reg-meter');
    let isPwdStrong = false;

    pwdInput.addEventListener('input', () => {
      const val = pwdInput.value;
      let score = 0;
      if (val.length >= 8) score++;
      if (/[A-Z]/.test(val)) score++;
      if (/[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      switch(score) {
        case 0:
        case 1: pwdMeter.style.width = '25%'; pwdMeter.style.backgroundColor = 'var(--danger)'; isPwdStrong = false; break;
        case 2: pwdMeter.style.width = '50%'; pwdMeter.style.backgroundColor = '#eab308'; isPwdStrong = false; break;
        case 3: pwdMeter.style.width = '75%'; pwdMeter.style.backgroundColor = '#60a5fa'; isPwdStrong = false; break;
        case 4: pwdMeter.style.width = '100%'; pwdMeter.style.backgroundColor = 'var(--accent-green)'; isPwdStrong = true; break;
      }
      if(val.length === 0) pwdMeter.style.width = '0%';
    });

    const form = document.getElementById('register-form');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorMsg = document.getElementById('error-msg');
      
      if (form.password.value !== form.confirmPassword.value) {
        errorMsg.textContent = 'Passwords do not match.';
        errorMsg.style.display = 'block';
        return;
      }
      
      if (!isPwdStrong) {
        errorMsg.textContent = 'Password does not meet strength requirements.';
        errorMsg.style.display = 'block';
        return;
      }

      const data = {
        fullName: form.fullName.value,
        username: form.username.value,
        email: form.email.value,
        password: form.password.value
      };
      
      try {
        const res = await fetch('/auth/register', {
          method: 'POST',
          body: JSON.stringify(data),
          headers: {'Content-Type': 'application/json'}
        });
        const result = await res.json();
        
        if (result.error) {
          errorMsg.textContent = result.error;
          errorMsg.style.display = 'block';
        } else if (result.user) {
          showToast('Registration successful! Please login.');
          setTimeout(() => location.assign('/auth/login'), 1500);
        }
      } catch (err) {
        errorMsg.textContent = 'An error occurred.';
        errorMsg.style.display = 'block';
      }
    });
  </script>
</body>
</html>
